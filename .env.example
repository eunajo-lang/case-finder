# Copy this file to .env only on the deployment server. Do not paste real values into chat.
APP_BASE_URL=https://case-finder.example.com
DATABASE_PATH=data/case_finder.sqlite3
# Use `firestore` in Cloud Run. Firestore uses the Cloud Run service identity;
# do not put a Google service-account key file in this project.
STORAGE_BACKEND=sqlite
FIRESTORE_COLLECTION_PREFIX=case_finder

# Create with: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# A distinct long random value used only to sign short-lived OAuth state.
STATE_SIGNING_SECRET=

# Slack app: Basic Information / App Credentials and OAuth & Permissions.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Atlassian developer console OAuth 2.0 (3LO) application.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Usually detected automatically after the user connects. Set only when a fixed site is required.
JIRA_CLOUD_ID=

# Google Cloud OAuth client of type Web application (not the desktop test client).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Optional. Without this, the app returns source candidates but does not create AI summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
